APP_NAME="Forum der Berufe"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

APP_LOCALE=de
APP_FALLBACK_LOCALE=de
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Local dev: the `ldap` docker service (see docker-compose.yml) is seeded with
# 5 test students (uid=student1..student5) and 5 test teachers (uid=teacher1..teacher5),
# all with password "student123"/"teacher123" respectively. Enable LDAP for a role via
# AppSetting::set('ldap_students', 'true') / AppSetting::set('ldap_consultants', 'true').
LDAP_LOGGING=true
LDAP_CONNECTION=default
LDAP_HOST=ldap
LDAP_USERNAME="cn=admin,dc=joborientation,dc=local"
LDAP_PASSWORD=admin
LDAP_PORT=389
LDAP_BASE_DN="ou=people,dc=joborientation,dc=local"
LDAP_TIMEOUT=5
LDAP_TLS=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local dev: set MAIL_HOST=mailcatcher, MAIL_PORT=1025, MAIL_MAILER=smtp
# Production: set MAIL_MAILER=smtp and fill in your SMTP provider credentials
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailcatcher
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
